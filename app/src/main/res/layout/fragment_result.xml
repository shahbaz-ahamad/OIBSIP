<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/white"
    tools:context=".fragment.ResultFragment">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quiz Results"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:gravity="center" />

    <!-- Progress for Correct Answers -->
    <ProgressBar
        android:id="@+id/correctProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:progress="70"
        android:progressTint="@color/green"
        android:backgroundTint="@color/gray"
        app:layout_constraintTop_toBottomOf="@id/titleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/correctTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Correct Answers"
        android:textColor="@color/green"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/correctProgressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Progress for Incorrect Answers -->
    <ProgressBar
        android:id="@+id/incorrectProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:progress="30"
        android:progressTint="@color/red"
        android:backgroundTint="@color/gray"
        app:layout_constraintTop_toBottomOf="@id/correctTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/incorrectTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Incorrect Answers"
        android:textColor="@color/red"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/incorrectProgressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Progress for Unattempted Answers -->
    <ProgressBar
        android:id="@+id/unattemptedProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:progress="10"
        android:progressTint="@color/yellow"
        android:backgroundTint="@color/gray"
        app:layout_constraintTop_toBottomOf="@id/incorrectTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/unattemptedTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unattempted Questions"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/unattemptedProgressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Summary Text -->
    <TextView
        android:id="@+id/summaryTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You answered 7 out of 10 questions correctly!"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/unattemptedTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp" />

    <!-- Button to retake quiz or go back -->
    <Button
        android:id="@+id/retakeQuizButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Retake Quiz"
        android:textColor="@color/white"
        android:backgroundTint="@color/blue"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/summaryTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:padding="12dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
